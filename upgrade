#!/bin/bash
# Three Man Team — upgrade tool
# Upgrades an existing Three Man Team project install to the version in this clone.
# Supports both CLIs the framework ships for: Claude Code and Codex.

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TPL="$SCRIPT_DIR/templates/project-folder"
SKILL_SRC="$SCRIPT_DIR/codex-skill"

usage() {
  cat <<'USAGE'
Three Man Team — upgrade tool

Usage:
  ./upgrade claude /path/to/your/project    upgrade a Claude Code install (default)
  ./upgrade codex  /path/to/your/project    upgrade a Codex install (skill + project)
  ./upgrade /path/to/your/project           same as: ./upgrade claude <project>

Options:
  --dry-run             show what would change, change nothing
  --replace-role-files  (claude only) also replace the three role files —
                        stock, never-renamed installs only.
                        Why claude only: a Claude Code install carries the FULL
                        role templates in the project, and a stock install is
                        detectable (the script fingerprints it), so wholesale
                        replacement is safe there. A Codex install keeps the
                        full templates inside the skill — which the codex
                        upgrade already refreshes — and the project holds only
                        stubs or your own customizations, neither of which can
                        be safely overwritten
  --migrate-role-files  (codex only) explicitly back up existing local role
                        files, then replace them with lean project deltas.

Environment:
  TMT_CODEX_SKILL_DIR   (codex only) exact skill directory to refresh.
                        Normally unnecessary: the upgrader checks the project,
                        ~/.agents/skills, then an existing $CODEX_HOME/skills
                        install (default CODEX_HOME: ~/.codex)

What the claude upgrade does:
  - installs playbooks/ and .claude/commands/ (framework-owned, role-neutral)
  - installs the RULES.md quality-contract skeleton if missing (never overwrites)
  - refreshes .claude/skills/token-optimization.md
  - points the version check in your role file at this repo
  - adds the Lessons section to your live BUILD-LOG

What the codex upgrade does:
  - refreshes the installed project or personal skill. It checks, in order:
    <project>/.agents/skills/three-man-team, ~/.agents/skills/three-man-team,
    then an existing $CODEX_HOME/skills/three-man-team install. Framework files
    live there. The previous version is kept outside the scanned skills folder,
    under the installation scope's skill-backups/ directory
  - re-runs the skill's setup-project.sh on your project, which only ADDS
    files introduced since your install (e.g. RULES.md) — existing files,
    role stubs, and handoff data are never overwritten
  - refreshes the personal skills-only plugin too when it is already present,
    then re-runs codex plugin add; a failed Codex install is reported as a failure

Both paths:
  - back up everything they edit
  - NEVER touch your live handoff data, personas, or team names
  - deliberately leave version_notified alone: the next Codex session walks
    project-specific release changes before it acknowledges them
USAGE
}

# --- args -------------------------------------------------------------------
CLI=""
PROJECT=""
REPLACE=0
MIGRATE_CODEX_ROLES=0
DRY=0

for arg in "$@"; do
  case "$arg" in
    claude|codex)
      if [ -z "$CLI" ] && [ -z "$PROJECT" ]; then CLI="$arg"; else PROJECT="$arg"; fi ;;
    --replace-role-files) REPLACE=1 ;;
    --migrate-role-files) MIGRATE_CODEX_ROLES=1 ;;
    --dry-run)            DRY=1 ;;
    -h|--help)            usage; exit 0 ;;
    -*)                   echo "Unknown option: $arg (see --help)"; exit 1 ;;
    *)                    PROJECT="$arg" ;;
  esac
done

[ -n "$CLI" ] || CLI="claude"   # backwards compatible: ./upgrade /path == claude

if [ -z "$PROJECT" ]; then
  echo "Usage: ./upgrade [claude|codex] [--replace-role-files] [--dry-run] /path/to/your/project"
  exit 1
fi
PROJECT="$(cd "$PROJECT" 2>/dev/null && pwd)" || { echo "✗ Project folder not found."; exit 1; }

if [ "$CLI" = "codex" ] && [ "$REPLACE" = 1 ]; then
  echo "✗ --replace-role-files applies to claude installs only."
  echo "  Codex role files are stubs you customized — the refreshed skill carries"
  echo "  the full templates at references/role-templates/ for you to re-apply."
  exit 1
fi
if [ "$CLI" != "codex" ] && [ "$MIGRATE_CODEX_ROLES" = 1 ]; then
  echo "✗ --migrate-role-files applies to codex installs only."
  exit 1
fi

# --- helpers ----------------------------------------------------------------
if sed --version >/dev/null 2>&1; then SED_GNU=1; else SED_GNU=0; fi
sed_i() { # sed_i 'expr' file
  if [ "$SED_GNU" = 1 ]; then sed -i "$1" "$2"; else sed -i '' "$1" "$2"; fi
}
say()  { echo "  $*"; }
plan() { if [ "$DRY" = 1 ]; then echo "  [dry-run] $*"; else echo "  ✓ $*"; fi; }

# --- sanity (common) ---------------------------------------------------------
echo ""
echo "========================================="
echo "  Three Man Team — Upgrade ($CLI)"
echo "========================================="
echo ""

[ -f "$TPL/playbooks/PLANNING.md" ] || {
  echo "✗ This clone looks incomplete or old. Run: git -C $SCRIPT_DIR pull"; exit 1; }

LATEST="$(sed -n 's/.*"latest": *"\([^"]*\)".*/\1/p' "$SCRIPT_DIR/releases/latest.json" | head -1)"
[ -n "$LATEST" ] || { echo "✗ Could not read version from this clone's releases/latest.json"; exit 1; }

# Soft staleness check against the remote registry (skip silently offline).
# Fail only when the remote is NEWER than the clone — a clone ahead of the
# registry is a developer working on an unreleased version, not a stale install.
REMOTE="$(curl -s --max-time 5 https://raw.githubusercontent.com/cloudaipro/three-man-team/main/releases/latest.json 2>/dev/null | sed -n 's/.*"latest": *"\([^"]*\)".*/\1/p' | head -1)"
if [ -n "$REMOTE" ] && [ "$REMOTE" != "$LATEST" ]; then
  NEWEST="$(printf '%s\n%s\n' "$LATEST" "$REMOTE" | sort -V | tail -1)"
  if [ "$NEWEST" = "$REMOTE" ]; then
    echo "⚠ This clone ships $LATEST but the registry says $REMOTE."
    echo "  Run: git -C $SCRIPT_DIR pull — then re-run this upgrade."
    exit 1
  fi
  echo "⚠ This clone ships $LATEST, ahead of the published registry ($REMOTE). Continuing."
fi

# =============================== CODEX PATH ==================================
if [ "$CLI" = "codex" ]; then
  [ -f "$SKILL_SRC/SKILL.md" ] || {
    echo "✗ This clone has no codex-skill/ directory. Run: git -C $SCRIPT_DIR pull"; exit 1; }

  PROJECT_SKILL_DEST="$PROJECT/.agents/skills/three-man-team"
  USER_SKILL_DEST="$HOME/.agents/skills/three-man-team"
  CODEX_HOME_SKILL_DEST="${CODEX_HOME:-$HOME/.codex}/skills/three-man-team"
  if [ -n "${TMT_CODEX_SKILL_DIR:-}" ]; then
    SKILL_DEST="$TMT_CODEX_SKILL_DIR"
  elif [ -d "$PROJECT_SKILL_DEST" ]; then
    SKILL_DEST="$PROJECT_SKILL_DEST"
  elif [ -d "$USER_SKILL_DEST" ]; then
    SKILL_DEST="$USER_SKILL_DEST"
  elif [ -d "$CODEX_HOME_SKILL_DEST" ]; then
    SKILL_DEST="$CODEX_HOME_SKILL_DEST"
  else
    # New standalone installs use Codex's documented personal-skill location.
    SKILL_DEST="$USER_SKILL_DEST"
  fi
  PLUGIN_DEST="${TMT_PLUGIN_ROOT:-$HOME/plugins}/three-man-team"
  LEGACY_PLUGIN_DEST="${TMT_MARKETPLACE_DIR:-$HOME/.agents/plugins}/plugins/three-man-team"

  if [ ! -f "$PROJECT/AGENTS.md" ] && [ ! -d "$PROJECT/handoff" ]; then
    echo "✗ No Three Man Team (Codex) install found at: $PROJECT"
    echo "  (looked for AGENTS.md and handoff/ — for a fresh install, run"
    echo "   codex-skill/scripts/setup-project.sh — see README, Codex Integration)"
    exit 1
  fi

  echo "Project:    $PROJECT"
  echo "Skill dir:  $SKILL_DEST"
  echo "Upgrading:  to $LATEST"
  [ "$DRY" = 1 ] && echo "Mode:       dry run — nothing will be changed"
  echo ""

  echo "— Refreshing the Codex skill (framework-owned files live here)"
  # Safety: this path gets replaced wholesale — only ever act on the exact
  # directory shape we own, never on whatever an env var happens to point at.
  case "$SKILL_DEST" in
    */skills/three-man-team) ;;
    *) echo "✗ Refusing to touch unexpected skill path: $SKILL_DEST"; exit 1 ;;
  esac

  if [ -d "$SKILL_DEST" ]; then
    SKILL_SCOPE_ROOT="$(dirname "$(dirname "$SKILL_DEST")")"
    SKILL_BACKUP_ROOT="$SKILL_SCOPE_ROOT/skill-backups"
    SKILL_BACKUP="$SKILL_BACKUP_ROOT/three-man-team-$(date +%Y%m%d-%H%M%S)"
    if [ "$DRY" = 0 ]; then
      mkdir -p "$SKILL_BACKUP_ROOT" || {
        echo "✗ Could not create skill backup directory: $SKILL_BACKUP_ROOT"; exit 1; }
      mv "$SKILL_DEST" "$SKILL_BACKUP" || {
        echo "✗ Could not back up existing skill to: $SKILL_BACKUP"; exit 1; }
      if ! cp -R "$SKILL_SRC" "$SKILL_DEST"; then
        echo "✗ Could not install the refreshed skill at: $SKILL_DEST"
        if mv "$SKILL_BACKUP" "$SKILL_DEST"; then
          echo "  Previous skill restored."
        else
          echo "  Previous skill remains at: $SKILL_BACKUP"
        fi
        exit 1
      fi
    fi
    plan "skill refreshed to $LATEST (previous version: $SKILL_BACKUP)"
  else
    if [ "$DRY" = 0 ]; then
      mkdir -p "$(dirname "$SKILL_DEST")"
      cp -R "$SKILL_SRC" "$SKILL_DEST"
    fi
    plan "skill was not installed — installed fresh at $SKILL_DEST"
  fi

  echo ""
  echo "— Project files (additive only — nothing existing is overwritten)"
  if [ "$DRY" = 0 ]; then
    if OUT="$("$SKILL_SRC/scripts/setup-project.sh" "$PROJECT" 2>&1)"; then
      echo "$OUT" | grep '✓' || say "nothing to add — project already has every framework file"
    else
      echo "$OUT"
      echo "✗ setup-project.sh failed — project files were not updated."
      exit 1
    fi
  else
    plan "run the skill's setup-project.sh — adds only files your project is missing (e.g. RULES.md and the aggregate audit)"
  fi

  if [ "$MIGRATE_CODEX_ROLES" = 1 ]; then
    echo ""
    echo "— Migrating Codex role files (explicit, backup-producing)"
    if [ "$DRY" = 0 ]; then
      ROLE_BACKUP_BASE="$PROJECT/.tmt-codex-role-backup-$(date +%Y%m%d-%H%M%S)"
      ROLE_BACKUP="$ROLE_BACKUP_BASE"
      ROLE_BACKUP_SUFFIX=0
      # mkdir without -p is the reservation: an existing backup is never reused.
      while ! mkdir "$ROLE_BACKUP" 2>/dev/null; do
        ROLE_BACKUP_SUFFIX=$((ROLE_BACKUP_SUFFIX + 1))
        ROLE_BACKUP="$ROLE_BACKUP_BASE-$ROLE_BACKUP_SUFFIX"
      done
      ROLE_FILES=()
      for role in ARCHITECT BUILDER REVIEWER; do
        if [ -f "$PROJECT/${role}.md" ]; then
          if ! cp "$PROJECT/${role}.md" "$ROLE_BACKUP/${role}.md"; then
            echo "✗ Could not back up ${role}.md; no role files were replaced."
            exit 1
          fi
          ROLE_FILES+=("$role")
        else
          say "${role}.md is absent; setup leaves it absent."
        fi
      done
      for role in "${ROLE_FILES[@]}"; do
        if ! cp "$SKILL_SRC/templates/project/${role}.md" "$PROJECT/${role}.md"; then
          echo "✗ Could not replace ${role}.md; restoring all migrated role files from $ROLE_BACKUP."
          for restore_role in "${ROLE_FILES[@]}"; do
            if ! cp "$ROLE_BACKUP/${restore_role}.md" "$PROJECT/${restore_role}.md"; then
              echo "✗ Could not restore ${restore_role}.md from $ROLE_BACKUP."
            fi
          done
          exit 1
        fi
        plan "${role}.md replaced with a lean delta (backup: $ROLE_BACKUP/${role}.md)"
      done
    else
      plan "back up existing role files, then replace them with lean Codex deltas"
    fi
  fi

  if [ -d "$PLUGIN_DEST" ]; then
    echo ""
    echo "— Refreshing registered Codex plugin"
    if [ "$DRY" = 0 ]; then
      if OUT="$("$SKILL_SRC/scripts/setup-project.sh" --plugin-only 2>&1)"; then
        echo "$OUT" | grep -E 'Staged plugin|Plugin installed|Codex plugin:' || say "plugin refreshed"
      else
        echo "$OUT"
        echo "✗ Plugin refresh failed — Codex did not confirm plugin installation."
        exit 1
      fi
    else
      plan "refresh registered skills-only plugin and run codex plugin add"
    fi
  else
    say "No registered personal plugin found — standalone skill refresh is complete."
    if [ -d "$LEGACY_PLUGIN_DEST" ]; then
      say "Legacy plugin payload found at $LEGACY_PLUGIN_DEST (not modified)."
      say "It predates the resolved personal marketplace source at $PLUGIN_DEST."
    fi
  fi

  echo ""
  echo "— Version acknowledgement: pending"
  say "Your manifest.md and version_notified marker were deliberately left untouched."
  say "In the next Codex session, check-version.py walks bundled release details before"
  say "the Architect acknowledges $LATEST for this project."

  echo ""
  echo "========================================="
  if [ "$DRY" = 1 ]; then
    echo "  Dry run complete — nothing was changed."
    echo "  Re-run without --dry-run to apply."
  else
    echo "  Codex upgrade to $LATEST complete."
    echo ""
    echo "  Next: start a Codex session in your project and type:"
    echo ""
    echo '  $three-man-team'
  fi
  echo "========================================="
  echo ""
  exit 0
fi

# =============================== CLAUDE PATH =================================

# Find the architect role file: manifest.md wins, ARCHITECT.md is the fallback
ARCH_FILE=""
if [ -f "$PROJECT/manifest.md" ]; then
  ARCH_FILE="$(sed -n 's/^architect:.*— *//p' "$PROJECT/manifest.md" | head -1 | tr -d ' ')"
fi
[ -n "$ARCH_FILE" ] || ARCH_FILE="ARCHITECT.md"

if [ ! -f "$PROJECT/$ARCH_FILE" ] && [ ! -d "$PROJECT/handoff" ]; then
  echo "✗ No Three Man Team install found at: $PROJECT"
  echo "  (looked for $ARCH_FILE and handoff/ — for a fresh install, see README Quick Start)"
  exit 1
fi

echo "Project:   $PROJECT"
echo "Upgrading: to $LATEST  (architect file: $ARCH_FILE)"
[ "$DRY" = 1 ] && echo "Mode:      dry run — nothing will be changed"
echo ""

# --- stock check for --replace-role-files ------------------------------------
if [ "$REPLACE" = 1 ]; then
  STOCK=1
  [ "$ARCH_FILE" = "ARCHITECT.md" ] || STOCK=0
  for f in ARCHITECT.md BUILDER.md REVIEWER.md; do
    [ -f "$PROJECT/$f" ] || STOCK=0
  done
  if [ -f "$PROJECT/ARCHITECT.md" ] && ! grep -q "Your name is Arch" "$PROJECT/ARCHITECT.md"; then
    STOCK=0
  fi
  if [ "$STOCK" = 0 ]; then
    echo "✗ --replace-role-files refused: this install looks renamed or customized."
    echo "  Replacing the role files would erase your team names and personas."
    echo "  Run the safe upgrade instead — your next /architect session will walk"
    echo "  the role-file changes with you, preserving your customizations."
    exit 1
  fi
fi

# --- backup ------------------------------------------------------------------
BACKUP="$PROJECT/.tmt-upgrade-backup-$(date +%Y%m%d-%H%M%S)"
backup() { # backup <relative-path>
  if [ -e "$PROJECT/$1" ] && [ "$DRY" = 0 ]; then
    mkdir -p "$BACKUP/$(dirname "$1")"
    cp -R "$PROJECT/$1" "$BACKUP/$1"
  fi
}

echo "— Installing framework-owned files (role-neutral, safe to refresh)"

# 1. playbooks/
backup "playbooks"
if [ "$DRY" = 0 ]; then
  mkdir -p "$PROJECT/playbooks"
  cp "$TPL/playbooks/"*.md "$PROJECT/playbooks/"
fi
plan "playbooks/ — PLANNING.md, DIAGNOSIS.md, BRIEF-EXAMPLES.md, VERSION-CHECK.md"

# 2. slash commands
if [ "$DRY" = 0 ]; then
  mkdir -p "$PROJECT/.claude/commands"
  cp "$TPL/.claude/commands/architect.md" "$TPL/.claude/commands/tmt-setup.md" "$PROJECT/.claude/commands/"
fi
plan ".claude/commands/ — /architect and /tmt-setup"

# 3. token-optimizer skill
if [ "$DRY" = 0 ]; then
  mkdir -p "$PROJECT/.claude/skills"
  cp "$TPL/.claude/skills/token-optimization.md" "$PROJECT/.claude/skills/"
fi
plan ".claude/skills/token-optimization.md refreshed"

# 3b. handoff structure check — framework-owned, always refreshed. RULES.md references it
# as a gate command, so a project that has the rule but not the script fails its own gate.
if [ "$DRY" = 0 ]; then
  mkdir -p "$PROJECT/scripts"
  cp "$TPL/scripts/check-handoff.sh" "$PROJECT/scripts/"
  chmod +x "$PROJECT/scripts/check-handoff.sh"
fi
plan "scripts/check-handoff.sh refreshed"

# 4. RULES.md quality contract (skeleton — never overwrites a drafted one)
if [ ! -f "$PROJECT/RULES.md" ]; then
  [ "$DRY" = 0 ] && cp "$TPL/RULES.md" "$PROJECT/RULES.md"
  plan "RULES.md — quality contract skeleton (Architect drafts the gate next session)"
else
  say "RULES.md — already present, left untouched."
fi

echo ""
echo "— Pointing the version check at this repo"

# 5. URL switch in role file (+ stale new-setup.md if still present)
for f in "$ARCH_FILE" new-setup.md; do
  if [ -f "$PROJECT/$f" ] && grep -q "russelleNVy/three-man-team" "$PROJECT/$f"; then
    backup "$f"
    [ "$DRY" = 0 ] && sed_i 's|russelleNVy/three-man-team|cloudaipro/three-man-team|g' "$PROJECT/$f"
    plan "$f — version check now fetches cloudaipro/three-man-team"
  fi
done

echo ""
echo "— Live handoff files (additive edits only)"

# 6. BUILD-LOG Lessons section
BL="$PROJECT/handoff/BUILD-LOG.md"
if [ -f "$BL" ] && ! grep -q "^## Lessons" "$BL"; then
  backup "handoff/BUILD-LOG.md"
  if [ "$DRY" = 0 ]; then
    awk 'BEGIN { block = "## Lessons\n*One line per bounced step or missed intent: what went wrong → which check would have caught it. Architect reads this before writing each new brief.*\n\n- **L-N** — [What went wrong → the check that would have caught it] — [date]\n\n---\n"; done = 0 }
         /^## Architecture Decisions/ && !done { print block; done = 1 }
         { print }
         END { if (!done) { print "\n---\n"; print block } }' "$BL" > "$BL.tmp" && mv "$BL.tmp" "$BL"
  fi
  plan "handoff/BUILD-LOG.md — Lessons section added (your data untouched)"
else
  say "handoff/BUILD-LOG.md — already has Lessons, or not present. Skipped."
fi

# --- role files + version markers --------------------------------------------
echo ""
if [ "$REPLACE" = 1 ]; then
  echo "— Replacing stock role files and stamping the version"

  for f in ARCHITECT.md BUILDER.md REVIEWER.md; do
    backup "$f"
    [ "$DRY" = 0 ] && cp "$TPL/$f" "$PROJECT/$f"
    plan "$f replaced with the $LATEST template"
  done

  if [ -f "$PROJECT/manifest.md" ]; then
    backup "manifest.md"
    if [ "$DRY" = 0 ]; then
      sed_i "s/^version:.*/version: $LATEST/" "$PROJECT/manifest.md"
      grep -q "^playbooks_dir:" "$PROJECT/manifest.md" || \
        sed_i 's|^handoff_dir:.*|&\nplaybooks_dir: playbooks/|' "$PROJECT/manifest.md"
    fi
    plan "manifest.md — version: $LATEST, playbooks_dir added"
  else
    if [ "$DRY" = 0 ]; then
      cat > "$PROJECT/manifest.md" <<MANIFEST
# Three Man Team — Manifest

version: $LATEST
installed: $(date +%Y-%m-%d)

## Team
architect: Arch — ARCHITECT.md
builder: Bob — BUILDER.md
reviewer: Richard — REVIEWER.md

## Project
handoff_dir: handoff/
playbooks_dir: playbooks/
repo:
branch: main
context_file: CLAUDE.md
MANIFEST
    fi
    plan "manifest.md created (stock team, $LATEST)"
  fi

  CP="$PROJECT/handoff/SESSION-CHECKPOINT.md"
  if [ "$DRY" = 0 ]; then
    mkdir -p "$PROJECT/handoff"
    if [ -f "$CP" ] && grep -q "^version_notified:" "$CP"; then
      backup "handoff/SESSION-CHECKPOINT.md"
      sed_i "s/^version_notified:.*/version_notified: $LATEST/" "$CP"
    else
      backup "handoff/SESSION-CHECKPOINT.md"
      printf '\n## Version Check\nversion_notified: %s\n' "$LATEST" >> "$CP"
    fi
  fi
  plan "SESSION-CHECKPOINT.md — version_notified: $LATEST (no redundant update walk)"
else
  echo "— Role files: left untouched (personas and team names preserved)"
  say "Your version markers were deliberately NOT updated. On your next session,"
  say "the version check will see $LATEST and walk the remaining role-file"
  say "upgrades with you — applying them to YOUR files, keeping your names."
fi

# --- done ---------------------------------------------------------------------
echo ""
echo "========================================="
if [ "$DRY" = 1 ]; then
  echo "  Dry run complete — nothing was changed."
  echo "  Re-run without --dry-run to apply."
else
  echo "  Upgrade to $LATEST complete."
  [ -d "$BACKUP" ] && echo "  Backups of edited files: $BACKUP"
  echo ""
  echo "  Next: open Claude Code in your project and type:"
  echo ""
  echo "  /architect"
  if [ "$REPLACE" = 0 ]; then
    echo ""
    echo "  Arch will finish the role-file wiring with you interactively."
  fi
fi
echo "========================================="
echo ""
