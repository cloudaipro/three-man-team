# OS
.DS_Store

# Claude Code local dev config — not for users
.claude/

# Override — template .claude/ must ship with installs
!templates/project-folder/.claude/
!templates/project-folder/.claude/**
!templates/generic/.claude/
!templates/generic/.claude/**

# Internal docs — not for public commit
three-man-team-build-brief.md
INTERNAL-BRIEF.md

# Reference clone for comparison work — its own repo, never committed here
agent-steward/

# Override global gitignore — docs/ is intentionally tracked (GitHub Pages)
!docs

# Override global *.json ignore — releases/ must be tracked
!releases/
!releases/*.json
.serena/
